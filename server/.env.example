# ==========================================
# Confera Backend Environment Configuration
# ==========================================

# Server Port
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In production, set to your frontend domain (e.g. https://app.confera.com)
ORIGINS=http://localhost:5173,http://localhost:3000

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/confera?sslmode=require

# Clerk Authentication Keys (from Clerk Dashboard > API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional: Google Gemini AI API Key (for meeting memory synthesis)
GEMINI_API_KEY=

# Optional: TURN Server Configuration for WebRTC (fallback is Google public STUN)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=confera_turn_user
# TURN_CREDENTIAL=confera_turn_secret
