# ==========================================
# Confera Frontend Environment Configuration
# ==========================================

# Clerk Publishable Key (must match backend Clerk application)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API Base URL (in production, your deployed backend URL without trailing slash)
VITE_BASE_URL=http://localhost:3000

# Optional: Dedicated WebRTC TURN Server
# VITE_TURN_URLS=turn:turn.example.com:3478
# VITE_TURN_USERNAME=confera_turn_user
# VITE_TURN_CREDENTIAL=confera_turn_secret
